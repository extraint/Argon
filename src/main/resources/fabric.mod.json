{
	"schemaVersion": 1,
	"id": "argon",
	"version": "${version}",
	"name": "Argon",
	"description": "Client-side performance add-on for Sodium: smarter culling, throttled particles and ambient updates, and chunk-loading tuning.",
	"authors": ["Argon contributors"],
	"license": "MIT",
	"icon": "assets/argon/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["dev.argon.ArgonClient"],
		"modmenu": ["dev.argon.gui.ArgonModMenu"],
		"sodium:config_api_user": ["dev.argon.config.ArgonSodiumConfig"]
	},
	"accessWidener": "${access_widener}",
	"mixins": ["argon.mixins.json", "argon.common.mixins.json"],
	"suggests": {
		"lithium": "*"
	},
	"depends": {
		"fabricloader": ">=${loader_min}",
		"minecraft": "${minecraft_dep}",
		"java": ">=${java_version}",
		"fabric-api": "*",
		"sodium": ">=${sodium_min}"
	}
}
