	"authors": ["Argon contributors"],
	"license": "MIT",
	"environment": "client",
	"entrypoints": { "client": ["dev.argon.ArgonClient"] },
	"mixins": ["argon.mixins.json"],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*",
		"sodium": ">=0.9.2"
	}
}
